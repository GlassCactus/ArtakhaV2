# Visual Studio
.vs/
*.suo
*.user
*.vcxproj.user

# Build output
x64/
x86/
Debug/
Release/

# Compiled binaries
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.obj
*.ipch

# Screenshots — keep the folder (so F5 works on a fresh clone), ignore the shots.
# Must be "screenshots/*", not "screenshots/": a trailing-slash rule makes git skip
# the directory entirely and the .gitkeep negation below would never be seen.
screenshots/*
!screenshots/.gitkeep

# CMake build folders (if used)
build/
CMakeFiles/
CMakeCache.txt

# Dear ImGui window layout, rewritten on every run
imgui.ini

# OS files
.DS_Store
Thumbs.db