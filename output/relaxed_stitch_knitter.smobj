# exported from Artakha knit sim (fully relaxed state)
# NOTE: knitting runs top-to-bottom in these coordinates -- cast-on is the
#       highest row. Bottom edges are loop-out (+l), top edges loop-in (-l).
#       This matches the row flip in CollectYarnCurves, so the .smobj and the
#       .bcc describe the same fabric. It is inverted vs faces/knitout.sf.
L bind-off-to-left-selvage-l +l0 -y1 -l1 x
L bind-off-to-left +l0 -y1 -l1 +y1
L bind-off-to-left-selvage-r +l0 x -l1 +y1
L knit-to-right-selvage-l +l1 +y1 -l1 x
L knit-to-right +l1 +y1 -l1 -y1
L knit-to-right-selvage-r +l1 x -l1 -y1
L knit-to-left-selvage-l +l1 -y1 -l1 x
L knit-to-left +l1 -y1 -l1 +y1
L knit-to-left-selvage-r +l1 x -l1 +y1
L cast-on-to-right-selvage-l +l1 +y1 -l0 x
L cast-on-to-right +l1 +y1 -l0 -y1
L cast-on-to-right-selvage-r +l1 x -l0 -y1
